// Renderizar com: neato -Tpng -Gdpi=200 diagrama.dot -o diagrama.png
digraph pedido {
    splines=true;
    node [fontname="Helvetica", fontsize=13, shape=ellipse, style=filled, fillcolor="#EAF1FB",
          color="#2F5597", width=1.55, height=0.6, fixedsize=true];
    edge [fontname="Helvetica", fontsize=12, color="#404040"];

    inicio [shape=point, width=0.2, fillcolor="black", color="black", label="", pos="-1.3,0!"];

    CRIADO     [pos="0,0!"];
    PAGO       [pos="3.3,0!"];
    EM_PREPARO [pos="6.6,0!"];
    PRONTO     [pos="6.6,-2.4!"];
    EM_ENTREGA [pos="3.3,-2.4!"];
    ENTREGUE   [shape=doublecircle, fillcolor="#E2F0D9", color="#2E7D32", width=1.15, height=1.15,
                pos="0,-2.4!"];
    CANCELADO  [shape=doublecircle, fillcolor="#FBE5E5", color="#B71C1C", width=1.3, height=1.3,
                pos="3.3,2.3!"];

    inicio -> CRIADO;
    CRIADO     -> PAGO       [label="pagar"];
    PAGO       -> EM_PREPARO [label="iniciar_preparo"];
    EM_PREPARO -> PRONTO     [label=" finalizar_preparo", labelfloat=true];
    PRONTO     -> EM_ENTREGA [label="despachar"];
    EM_ENTREGA -> ENTREGUE   [label="confirmar_entrega"];

    CRIADO     -> CANCELADO  [label="cancelar", color="#B71C1C", fontcolor="#B71C1C"];
    PAGO       -> CANCELADO  [label=" cancelar", color="#B71C1C", fontcolor="#B71C1C"];
    EM_PREPARO -> CANCELADO  [label="cancelar", color="#B71C1C", fontcolor="#B71C1C"];
}
